# Optional Adzuna access. Register at https://developer.adzuna.com/ to obtain both values.
# Adzuna display/production use is subject to its current API terms and any required licence.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# Comma-separated Greenhouse board tokens from company career URLs.
# Example: GREENHOUSE_BOARDS=exampleco,anotherco
GREENHOUSE_BOARDS=

# Comma-separated Lever site names from their company postings URLs.
# Example: LEVER_SITES=exampleco,anotherco
LEVER_SITES=

# Job data cache duration in milliseconds (default: 600000, minimum: 60000).
JOB_CACHE_TTL_MS=600000
